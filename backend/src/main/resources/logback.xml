<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${BEATLINK_LOG_DIR:-.}/beatlink-monitor.log</file>
        <!-- A new file per day, and also whenever one reaches 50 MB; 14 days and 1 GB in total are kept. -->
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${BEATLINK_LOG_DIR:-.}/beatlink-monitor.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Default level is INFO (Pflichtenheft §24); DEBUG/TRACE can be enabled via
         developmentMode / application.json without a code change. -->
    <root level="${BEATLINK_LOG_LEVEL:-INFO}">
        <appender-ref ref="STDOUT" />
        <appender-ref ref="FILE" />
    </root>

    <logger name="io.netty" level="WARN" />

    <!-- Beat-Link's track loading subsystems repeat the same INFO/WARN lines (with stack traces) for every player and
         every dropout while a player cannot be reached; on a flaky network that was tens of thousands of lines per
         hour. The application's own "Pro DJ Link health" lines and the diagnostics view summarise the same
         problem. Set BEATLINK_LIBRARY_LOG_LEVEL=INFO (or DEBUG) to get the full library output back. -->
    <logger name="org.deepsymmetry.beatlink.data.WaveformFinder" level="${BEATLINK_LIBRARY_LOG_LEVEL:-WARN}" />
    <logger name="org.deepsymmetry.beatlink.data.BeatGridFinder" level="${BEATLINK_LIBRARY_LOG_LEVEL:-WARN}" />
    <logger name="org.deepsymmetry.beatlink.data.TimeFinder" level="${BEATLINK_LIBRARY_LOG_LEVEL:-WARN}" />
    <logger name="org.deepsymmetry.beatlink.data.MetadataFinder" level="${BEATLINK_LIBRARY_LOG_LEVEL:-ERROR}" />
    <logger name="org.deepsymmetry.beatlink.data.CrateDigger" level="${BEATLINK_LIBRARY_LOG_LEVEL:-ERROR}" />
    <logger name="org.deepsymmetry.beatlink.dbserver.ConnectionManager" level="${BEATLINK_LIBRARY_LOG_LEVEL:-ERROR}" />
</configuration>
